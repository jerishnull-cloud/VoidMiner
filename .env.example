# ==================================================
# VOID miner — Official Gaming Channel Configuration
# ==================================================

# YOUTUBE_API_KEY: Google Cloud API Key with "YouTube Data API v3" enabled.
# Generate one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY_HERE"

# YOUTUBE_CHANNEL_ID: Your unique YouTube Channel ID (starts with "UC", e.g. UC_x5XG1OV2P6uZZ5FSM9Ttw).
# Find your Channel ID at: https://www.youtube.com/account_advanced
YOUTUBE_CHANNEL_ID="YOUR_YOUTUBE_CHANNEL_ID_HERE"

# PORT: Local development server port (default 3000)
PORT=3000

# GEMINI_API_KEY: Set in the server environment only if server-side AI features are enabled.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Public Supabase project configuration (never use the service_role key here).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Configure this OAuth client ID and its client secret in Supabase Auth > Providers > Google.
VITE_GOOGLE_CLIENT_ID="548947679816-ct8fkq8ki7toi3ooqcrgp8rjsbel540p.apps.googleusercontent.com"

# Server-only Supabase Postgres URLs. Replace the password placeholders in local .env.
# Percent-encode reserved URL characters in the password before inserting it.
# Runtime/transaction pooler (IPv4); pgbouncer=true disables prepared statements.
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR_DATABASE_PASSWORD@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma migrations/session pooler.
DIRECT_URL="postgresql://postgres.your-project-ref:YOUR_DATABASE_PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres"
